{
  "version": 2,
  "author": "KhomDev",
  "ci_repo": "KhomDev/oss-ci",
  "min_rest_quota": 300,
  "footer": "🤖 Generated with [Claude Code](https://claude.com/claude-code)",
  "co_author_pattern": "^Co-Authored-By: Claude [A-Za-z0-9 .]+ <noreply@anthropic\\.com>$",
  "bot_logins": [
    "greptile-apps",
    "coderabbitai",
    "carsonbot402",
    "PhilBot402",
    "mintlify",
    "vercel",
    "changeset-bot",
    "codecov",
    "github-actions",
    "dependabot",
    "claude",
    "copilot-pull-request-reviewer",
    "sonarqubecloud",
    "netlify",
    "socket-security"
  ],
  "launch": {
    "min_free_mb": 1024,
    "spacing_s": 150,
    "max_agents": 4
  },
  "public_text": {
    "error_patterns": [
      "\\bhaiku\\b",
      "\\bsub-?agents?\\b",
      "\\borchestrat\\w*",
      "[A-Za-z]:\\\\Users\\\\",
      "/c/Users/",
      "[\\w.+-]+@gmail\\.com"
    ],
    "warn_patterns": [
      "\\baudit(s|ed|ing|or|ors)?\\b",
      "\\bexploit\\w*",
      "\\bvulnerab\\w*",
      "\\battacker\\w*",
      "\\bagents?\\b"
    ]
  },
  "repos": {
    "x402": {
      "upstream": "x402-foundation/x402",
      "fork": "KhomDev/x402",
      "default_branch": "main",
      "budget": 3,
      "process": {
        "issue_first": false,
        "draft_first": true,
        "cla": false,
        "signed_commits": true
      },
      "title": {
        "regex": "^(feat|fix|docs|chore|test|refactor|perf|ci|build)(\\([a-z0-9][a-z0-9/_.-]*\\))?!?: [a-z0-9`].*$",
        "max_len": 72,
        "enforcement": "error"
      },
      "commit_subject_enforcement": "error",
      "ai_disclosure": "required",
      "pr_body": "template",
      "changelog": "typescript/.changeset (pnpm -C typescript changeset); go/.changes/unreleased (make -C go changelog-new); python/x402/changelog.d (towncrier). Docs-only changes skip.",
      "sources": [
        "CONTRIBUTING.md",
        ".github/pull_request_template.md",
        "docs/AGENTS.md"
      ],
      "card": "repos/x402.md",
      "examples": {
        "good": [
          "test(near): allowlist the test asset in the exact integration client",
          "fix(python/flask): close the wrapped WSGI response on paid routes"
        ],
        "bad": [
          "Fix the NEAR relayer queue",
          "fix: Add expiry check.",
          "near: evict expired entries"
        ]
      },
      "body_sections": [
        "Description",
        "Tests",
        "Checklist"
      ],
      "oss_dir": "x402"
    },
